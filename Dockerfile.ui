# ==============================================================================
# Production Dockerfile for Wine Classification & Prediction Streamlit Frontend
# Base: Python 3.13 slim (official Debian-based lightweight image)
# Security: Non-root execution (UID 10001), decoupled from ML models/backend
# ==============================================================================

FROM python:3.13-slim

# Set environment variables for optimized container runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Set explicit application directory
WORKDIR /app

# Create dedicated non-root application user and group (UID 10001)
RUN groupadd -r -g 10001 appuser && \
    useradd -r -u 10001 -g appuser -d /app -s /sbin/nologin -c "Application Runner" appuser

# Install lean frontend runtime dependencies before copying source for layer caching
COPY requirements-ui-docker.txt .

RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir -r requirements-ui-docker.txt && \
    python -m pip check

# Copy only frontend source, configuration, and shared package scaffolding
# Models, training data, and backend ML modules are strictly excluded from UI container
COPY --chown=appuser:appuser src/__init__.py src/config.py ./src/
COPY --chown=appuser:appuser src/frontend/ ./src/frontend/
COPY --chown=appuser:appuser README.md ./

# Switch to non-root user
USER appuser

# Expose Streamlit application port
EXPOSE 8501

# Container liveness health probe via Streamlit internal health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request, sys; res = urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health'); sys.exit(0 if res.getcode() == 200 else 1)"

# Production Streamlit entry point
CMD ["streamlit", "run", "src/frontend/app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
