# Environment Configuration Template for Wine Classification & Prediction Service
# Copy to .env for local overrides (never commit real .env to version control)

# --- FastAPI Backend Configuration ---
# Host network socket binding for backend service
HOST=0.0.0.0
PORT=8000

# Host port mapping for FastAPI backend in Docker Compose (default: 8000)
API_PORT=8000

# Worker concurrency (default: 1 for local development)
WORKERS=1

# Backend Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# --- Streamlit Frontend Configuration ---
# Host port mapping for Streamlit dashboard in Docker Compose (default: 8501)
UI_PORT=8501

# Backend API URL used by the frontend for inference and metadata queries:
# - In Docker Compose: http://wine-api:8000 (resolves via Compose internal DNS)
# - In Local Development: http://127.0.0.1:8000 (direct host loopback)
API_BASE_URL=http://wine-api:8000
